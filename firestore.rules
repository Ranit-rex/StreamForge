rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null; }
    function isOwner(uid) { return signedIn() && request.auth.uid == uid; }
    function isAdmin() { return signedIn() && request.auth.token.admin == true; }

    function validPublicIdClaim(publicId, uid) {
      return existsAfter(/databases/$(database)/documents/publicIds/$(publicId))
        && getAfter(/databases/$(database)/documents/publicIds/$(publicId)).data.uid == uid;
    }

    match /users/{uid} {
      allow read: if isOwner(uid);
      allow create: if isOwner(uid)
        && request.resource.data.keys().hasOnly([
          'uid','publicId','displayName','email','photoUrl','createdAt','updatedAt',
          'termsAcceptedAt','termsVersion','provider','accountStatus'
        ])
        && request.resource.data.keys().hasAll([
          'uid','publicId','displayName','createdAt','updatedAt','termsAcceptedAt',
          'termsVersion','provider','accountStatus'
        ])
        && request.resource.data.uid == uid
        && request.resource.data.publicId is string
        && request.resource.data.publicId.matches('^[A-Z0-9]{5}$')
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.termsVersion is string
        && request.resource.data.termsVersion.size() <= 20
        && request.resource.data.provider == 'google.com'
        && request.resource.data.accountStatus == 'active'
        && request.resource.data.createdAt == request.time
        && request.resource.data.updatedAt == request.time
        && request.resource.data.termsAcceptedAt == request.time
        && validPublicIdClaim(request.resource.data.publicId, uid);
      allow update: if isOwner(uid)
        && request.resource.data.uid == resource.data.uid
        && request.resource.data.publicId == resource.data.publicId
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['displayName','photoUrl','updatedAt'])
        && request.resource.data.displayName is string
        && request.resource.data.displayName.size() <= 60
        && request.resource.data.updatedAt == request.time;
      allow delete: if false;
    }

    match /publicIds/{publicId} {
      allow get: if signedIn();
      allow list: if false;
      allow create: if signedIn()
        && publicId.matches('^[A-Z0-9]{5}$')
        && request.resource.data.keys().hasOnly(['uid','createdAt'])
        && request.resource.data.keys().hasAll(['uid','createdAt'])
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && !exists(/databases/$(database)/documents/publicIds/$(publicId))
        && getAfter(/databases/$(database)/documents/users/$(request.auth.uid)).data.publicId == publicId;
      allow update, delete: if false;
    }

    match /chatRooms/{roomId} {
      function isParticipant() {
        return signedIn() && request.auth.uid in resource.data.participants;
      }
      allow read: if isParticipant();
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['participants','createdBy','createdAt','type','lastMessageAt'])
        && request.resource.data.keys().hasAll(['participants','createdBy','createdAt','type'])
        && request.resource.data.participants is list
        && request.resource.data.participants.size() == 2
        && request.auth.uid in request.resource.data.participants
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.createdAt == request.time
        && request.resource.data.type in ['direct','voice'];
      allow update: if isParticipant()
        && request.resource.data.participants == resource.data.participants
        && request.resource.data.createdBy == resource.data.createdBy
        && request.resource.data.createdAt == resource.data.createdAt
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lastMessageAt']);
      allow delete: if false;

      match /messages/{messageId} {
        function parentRoom() { return get(/databases/$(database)/documents/chatRooms/$(roomId)).data; }
        function roomMember() { return signedIn() && request.auth.uid in parentRoom().participants; }
        allow read: if roomMember();
        allow create: if roomMember()
          && request.resource.data.keys().hasOnly(['senderId','text','createdAt','type'])
          && request.resource.data.keys().hasAll(['senderId','text','createdAt','type'])
          && request.resource.data.senderId == request.auth.uid
          && request.resource.data.text is string
          && request.resource.data.text.size() <= 5000
          && request.resource.data.createdAt == request.time
          && request.resource.data.type in ['text','system'];
        allow update, delete: if false;
      }
    }

    match /invites/{inviteId} {
      allow read: if signedIn() && (request.auth.uid == resource.data.fromUid || request.auth.uid == resource.data.toUid);
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['fromUid','toUid','status','createdAt','roomId','message'])
        && request.resource.data.keys().hasAll(['fromUid','toUid','status','createdAt'])
        && request.resource.data.fromUid == request.auth.uid
        && request.resource.data.toUid is string
        && request.resource.data.toUid != request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && (!('message' in request.resource.data) || (request.resource.data.message is string && request.resource.data.message.size() <= 300));
      allow update: if signedIn()
        && request.auth.uid == resource.data.toUid
        && request.resource.data.fromUid == resource.data.fromUid
        && request.resource.data.toUid == resource.data.toUid
        && request.resource.data.createdAt == resource.data.createdAt
        && resource.data.status == 'pending'
        && request.resource.data.status in ['accepted','declined']
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status']);
      allow delete: if false;
    }

    // User-owned FCM tokens. Tokens are never readable by other users or admins from clients.
    match /users/{uid}/deviceTokens/{tokenId} {
      allow read: if isOwner(uid);
      allow create, update: if isOwner(uid)
        && request.resource.data.keys().hasOnly(['token','platform','updatedAt'])
        && request.resource.data.keys().hasAll(['token','platform','updatedAt'])
        && request.resource.data.token is string
        && request.resource.data.token.size() <= 4096
        && request.resource.data.platform == 'android'
        && request.resource.data.updatedAt == request.time;
      allow delete: if isOwner(uid);
    }

    // Notifications are written by trusted server/admin SDK only.
    // Each user's inbox can only be read and marked as read by that user.
    match /users/{uid}/notifications/{notificationId} {
      allow get, list: if isOwner(uid);
      allow create, delete: if false;
      allow update: if isOwner(uid)
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read','readAt'])
        && request.resource.data.read == true
        && request.resource.data.readAt == request.time;
    }

    // Admin-created broadcast campaigns. Admin custom claim is assigned out-of-band.
    match /notificationCampaigns/{campaignId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly([
          'title','body','imageUrl','actionUrl','target','targetUids',
          'priority','createdAt','createdBy','status'
        ])
        && request.resource.data.keys().hasAll([
          'title','body','target','priority','createdAt','createdBy','status'
        ])
        && request.resource.data.title is string
        && request.resource.data.title.size() > 0
        && request.resource.data.title.size() <= 100
        && request.resource.data.body is string
        && request.resource.data.body.size() > 0
        && request.resource.data.body.size() <= 2000
        && request.resource.data.target in ['all','selected']
        && request.resource.data.priority in ['normal','important']
        && request.resource.data.createdAt == request.time
        && request.resource.data.createdBy == request.auth.uid
        && request.resource.data.status == 'queued'
        && (request.resource.data.target == 'all'
          || (request.resource.data.targetUids is list && request.resource.data.targetUids.size() <= 500));
      allow update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
